#!/usr/bin/env perl

use v5.36;

use FindBin;
use lib "$FindBin::Bin/../lib";

use Pascal::Lexer;
use Pascal::Parser;
use Pascal::Linter;


# Simply use default setting for now.
Pascal::Lexer::init();

for my $arg (@ARGV) {
    my $file_name = $arg;
    open(my $FH, '<', $file_name) or die "Unable to open $file_name";

    my $lexer = Pascal::Lexer->new();
    my $line_number = 1;

    while (my $line = <$FH>) {
        $lexer->lex($line, $line_number);

        $line_number++;
    }

    close $FH;

    my $parser = Pascal::Parser->new();
    $parser->parse($lexer);

    my $linter = Pascal::Linter->new(Pascal::Linter->ALL_RULES);
    $linter->lint($parser, $file_name);
}
