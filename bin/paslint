#!/usr/bin/env perl

use v5.36;

use FindBin;
use lib "$FindBin::Bin/../lib";

use Pascal::Lexer;
use Pascal::AST;
use Pascal::BlockAST;
use Pascal::Parser;


# The lint rule switches.
use constant {
    RULE_LONG_LINE  => 1 << 0,  # 0001
    RULE_SNAKE_CASE => 1 << 1,  # 0010
};
my $RULES = RULE_LONG_LINE | RULE_SNAKE_CASE;


# Simply use default setting for now.
Pascal::Lexer::init();

for my $arg (@ARGV) {
    my $file_name = $arg;
    open(my $FH, '<', $file_name) or die "Unable to open $file_name";

    my $lexer = Pascal::Lexer->new();
    my $line_number = 1;

    while (my $line = <$FH>) {
        $lexer->lex($line, $line_number);

        $line_number++;
    }

    close $FH;

    my $parser = Pascal::Parser->new();
    $parser->parse($lexer);

    while ($parser->has_next()) {
        my $ast = $parser->next();

        say $ast->format();
    }
}
