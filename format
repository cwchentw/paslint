#!/bin/sh

CWD=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd) || exit 1

FORMATER="${CWD}/tools/bin/format"

DEMO_DIR="${CWD}/demo"

if [ ! -x "$FORMATER" ]; then
    echo "Error: Formatter not executable: $FORMATER" >&2
    exit 1
fi

if [ ! -d "${DEMO_DIR}" ]; then
    echo "Error: the source directory does not exist: ${SRC_DIR}" >&2
    exit 1
fi

while IFS= read -r file; do
    if ! "$FORMATER" "$file"; then
        echo "Error: Stop execution. Formatting failed on: $file" >&2
        exit 1
    fi
done << EOF
$(find "${DEMO_DIR}" -type f)
EOF

echo "All files formatted successfully."
